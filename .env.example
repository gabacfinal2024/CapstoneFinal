# Backend settings (copy to CAPSTONE/.env; never commit the real file)

# Supabase service-role key: lets Django write camera results into the app tables
# (products freshness + price, spoilage_predictions, sensor_logs, notifications, auto-listing).
# Supabase dashboard → Project Settings → API → service_role (secret). Keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
# SUPABASE_URL=https://yyrmuaocpnrlkeedwpzx.supabase.co
# DEVICE_SERVER_URL=http://192.168.1.4:8000   # address cameras use; default = auto-detect this PC's LAN IP
# IOT_TEMP_ALERT_THRESHOLD=30
# DJANGO_SECRET_KEY=change-me
# DEBUG=True

# Facebook Messenger (keep FB_PAGE_TOKEN server-side; never add it to a frontend .env)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_RECIPIENT_PSID=
FB_API_VERSION=v25.0
FB_AUTO_NOTIFY_ENABLED=false
FB_LOG_PSID=false
# FB_VERIFY_TOKEN=
# FB_APP_SECRET=
